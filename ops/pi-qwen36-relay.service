[Unit]
Description=Persistent Pi Qwen3.6 capture relay
After=network-online.target qwen36-ngram.service
Wants=qwen36-ngram.service

[Service]
Type=simple
WorkingDirectory=/home/john/AI-Mega-App
ExecStart=/usr/bin/python3 /home/john/AI-Mega-App/scripts/pi_request_capture_proxy.py
Environment=PI_PROXY_PORT=8082
Environment=PI_PROXY_UPSTREAM_PORT=5807
Environment=PI_PROXY_ALLOWED_CLIENT=192.168.0.246
Environment=PI_PROXY_CAPTURE_DIR=/tmp/pi-qwen36-captures
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
