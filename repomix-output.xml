  useRef,
  useState,
} from "react";
import {
  listThreads,
  getMessages,
  streamChat,
  getSources,
  MessageRecord,
  SourcesState,
  SourceChunk,
  StreamChatError,
} from "../api/client";
import MessageBubble, { ToolEvent } from "./MessageBubble";
import ModelSelector from "./ModelSelector";
import ToolToggles, { ToolTogglesState } from "./ToolToggles";
import DebugTracePanel, { TraceEntry } from "./DebugTracePanel";

